{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "./**/*.ts",
    "../pages/**/*.ts",
    "../playwright.config.ts",
    "../playwright.auth.config.ts"
  ]
}
